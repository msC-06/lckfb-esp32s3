# ESP-IDF 编译产物
build/
sdkconfig
sdkconfig.old
*.bin
*.elf
*.map
flash_args
flasher_args.json
partition_table/

# ESP-IDF 自动拉取的外部组件，不上传
managed_components/

# clangd本地索引文件，每台电脑不一样
.clangd

# vscode 临时日志，保留settings.json
.vscode/!settings.json
.vscode/*.log
.vscode/extensions.json

# 废弃旧文件，不上传github
esp32_s3_szp.c
esp32_s3_szp.h

# 临时文件、校验用bin
*.log
*.tmp
verify_hzk.bin

# 环境相关
.env

# ============================================================
# 私有密钥：绝对不要提交！
#   入库的只有 components/app/app_config_template.h（占位符）
#   真实密钥写进 components/app/app_config_secret.h（被忽略）
#   用法：cp components/app/app_config_template.h components/app/app_config_secret.h
# ============================================================
app_config_secret.h
**/app_config_secret.h
